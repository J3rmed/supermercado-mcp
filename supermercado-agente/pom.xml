<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.udea</groupId>
    <artifactId>supermercado-agente</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>supermercado-agente</name>
    <description>Chatbot de supermercado con Google ADK y cliente MCP</description>
    <!-- ADK gestiona su servidor web. No heredar el parent Boot del servidor MCP. -->
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <google-adk.version>1.14.0</google-adk.version>
        <adk.port>8081</adk.port>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.google.adk</groupId><artifactId>google-adk</artifactId><version>${google-adk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.adk</groupId><artifactId>google-adk-dev</artifactId><version>${google-adk.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
                <configuration><parameters>true</parameters></configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version>
                <executions>
                    <execution>
                        <id>adk-web</id><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>com.google.adk.web.AdkWebServer</mainClass>
                            <arguments>
                                <argument>--adk.agents.source-dir=target</argument>
                                <argument>--server.address=127.0.0.1</argument>
                                <argument>--server.port=${adk.port}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mcp-check</id><goals><goal>java</goal></goals>
                        <configuration><mainClass>com.udea.supermercado.agente.McpCheck</mainClass></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
